# Copy to .env.production locally; enter real values in Vercel's Production environment.
NODE_ENV=production
PORT=8104
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_CLUSTER/vetify_blog_production?retryWrites=true&w=majority
MAIN_AUTH_ORIGIN=https://vetify.page
AUTH_CLIENT_ID=vetify-blog
AUTH_CALLBACK_URL=https://blog.vetify.page/auth/callback
CLIENT_ORIGIN=https://blog.vetify.page
# Enable only after main implements and passes the OIDC + v2 introspection contract.
AUTH_ENABLED=false
# Generate an independent 32-byte hex key before enabling SSO.
AUTH_SESSION_KEY=
GEMINI_API_KEY=
# Confirm this model is available to your Gemini project before enabling screening.
GEMINI_MODERATION_MODEL=gemini-3.5-flash
# VITE_ values are public and embedded in the browser build.
VITE_API_URL=/api/v1
